// Managed by Ansible (role: auto_updates)
// Loaded after the distribution's 50unattended-upgrades, so these values win.
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if auto_updates_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ auto_updates_reboot_time }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ 'true' if auto_updates_remove_unused_dependencies | bool else 'false' }}";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::SyslogEnable "true";
